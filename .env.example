# Django
DJANGO_SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite для разработки, PostgreSQL для прода)
USE_POSTGRES=False
DB_NAME=albapack
DB_USER=postgres
